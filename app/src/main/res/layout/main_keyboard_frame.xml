<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr" >

        <LinearLayout
            android:id="@+id/sellby_toolbar_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- 0dp on purpose: SellbyToolbarView animates this height at runtime (panel open/close) -->
            <FrameLayout
                android:id="@+id/sellby_panel_region"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="Suspicious0dp" />

            <helium314.keyboard.keyboard.toolbar.SellbyToolbarView
                android:id="@+id/sellby_toolbar_row"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Emoji/Clipboard reparented here (instead of overlapping keyboard_view_wrapper
                 siblings) so sellby_toolbar_row stays visible above them as a normal LinearLayout
                 stack entry - no margin/gravity tricks needed, see the plan file's "Penyesuaian
                 Keyboard Utama" section for why that was tried first and abandoned
                 (emoji_palettes_view's layout_gravity="bottom" ignores marginTop entirely).
                 Only one of these three is VISIBLE at a time, same mutually-exclusive toggling
                 KeyboardSwitcher already did when they were top-level siblings. calculator_view is
                 deliberately NOT moved here - Calculator keeps hiding the whole toolbar stack. -->
            <helium314.keyboard.keyboard.MainKeyboardView
                android:id="@+id/keyboard_view"
                android:layoutDirection="ltr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/emoji_palettes_view"
                layout="@layout/emoji_palettes_view" />
            <include
                android:id="@+id/clipboard_history_view"
                layout="@layout/clipboard_history_view" />
        </LinearLayout>
        <include
            android:id="@+id/calculator_view"
            layout="@layout/calculator_view" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageView
            android:id="@+id/backgroundGatheringIndicator"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/btn_keyboard_key_action_normal_lxx_base"
            android:tint="#a00000"
            android:layout_gravity="top"
            />
    </helium314.keyboard.latin.KeyboardWrapperView>
    <LinearLayout
        android:id="@+id/float_handle_container"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_arrow_horizontal"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_drag_indicator"/>
    </LinearLayout>
</LinearLayout>
