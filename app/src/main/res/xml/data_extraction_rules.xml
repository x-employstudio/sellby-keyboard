<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only

    What Android may copy to the user's Google Drive backup (cloud-backup) or to a new phone (device-transfer).
    Android 12+; the same list for Android 11 and older is backup_rules.xml.

    The app runs with defaultToDeviceProtectedStorage="true", so everything lives in the "device_*" domains.
    As soon as a domain has an <include>, ONLY the included paths of that domain are copied.

    Backed up: the seller's business data (customers, orders, products, payment methods, auto-texts) in
    sellby.db, the QRIS photos, and the preferences (store profile, templates, keyboard settings, and the trial
    / purchase state - a restored purchase flag is only a cache: the app re-checks it with Google Play on every
    start and corrects it).
    NOT backed up: the clipboard history database (heliboard.db) and the clipboard files, the keyboard's
    learned-word / personalization data, dictionaries and everything else in the files directory.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_database" path="sellby.db" />
        <include domain="device_database" path="sellby.db-wal" />
        <include domain="device_database" path="sellby.db-shm" />
        <include domain="device_file" path="qris_photos" />
        <include domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="device_database" path="sellby.db" />
        <include domain="device_database" path="sellby.db-wal" />
        <include domain="device_database" path="sellby.db-shm" />
        <include domain="device_file" path="qris_photos" />
        <include domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
